{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ClaudeAufrufen",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:eu-central-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-3::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-south-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-south-2::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-north-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:*:AWS-KONTONUMMER:inference-profile/eu.anthropic.claude-*"
      ]
    },
    {
      "Sid": "TexterkennungFuerScans",
      "Effect": "Allow",
      "Action": "textract:DetectDocumentText",
      "Resource": "*"
    },
    {
      "Sid": "SchutzgelaenderAnwenden",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": [
        "arn:aws:bedrock:eu-central-1:*:guardrail/*",
        "arn:aws:bedrock:eu-west-1:*:guardrail/*",
        "arn:aws:bedrock:eu-west-3:*:guardrail/*",
        "arn:aws:bedrock:eu-south-1:*:guardrail/*",
        "arn:aws:bedrock:eu-south-2:*:guardrail/*",
        "arn:aws:bedrock:eu-north-1:*:guardrail/*",
        "arn:aws:bedrock:eu-central-1:*:guardrail-profile/*",
        "arn:aws:bedrock:eu-west-1:*:guardrail-profile/*",
        "arn:aws:bedrock:eu-west-3:*:guardrail-profile/*",
        "arn:aws:bedrock:eu-south-1:*:guardrail-profile/*",
        "arn:aws:bedrock:eu-south-2:*:guardrail-profile/*",
        "arn:aws:bedrock:eu-north-1:*:guardrail-profile/*"
      ]
    },
    {
      "Sid": "ModelleAnsehen",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "aws-marketplace:ViewSubscriptions",
        "bedrock:GetModelInvocationLoggingConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KeinAnderesModell",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "NotResource": [
        "arn:aws:bedrock:eu-central-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-3::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-south-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-south-2::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-north-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:*:AWS-KONTONUMMER:inference-profile/eu.anthropic.claude-*"
      ]
    },
    {
      "Sid": "NurEuUndEwr",
      "Effect": "Deny",
      "Action": "bedrock:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "eu-central-1",
            "eu-west-1",
            "eu-west-3",
            "eu-south-1",
            "eu-south-2",
            "eu-north-1"
          ]
        }
      }
    },
    {
      "Sid": "KeineModellverwaltung",
      "Effect": "Deny",
      "Action": [
        "bedrock:CreateModelCustomizationJob",
        "bedrock:CreateModelInvocationJob",
        "bedrock:PutModelInvocationLoggingConfiguration",
        "bedrock:DeleteModelInvocationLoggingConfiguration",
        "bedrock:DeleteGuardrail",
        "bedrock:UpdateGuardrail"
      ],
      "Resource": "*"
    }
  ]
}
