# jusperfect – Beispielkonfiguration für den lokalen Betrieb.
# Kopie als .env anlegen; .env wird nicht eingecheckt. Keine Zugangsdaten im Code.
# In AWS setzt die SAM-Vorlage (infra/template.yaml) diese Variablen selbst.

JUSPERFECT_BETRIEBSART=lokal            # lokal | aws

# KI-Anbieter: bedrock (AWS) oder demo (offline, ohne KI, nur zur Vorführung)
JUSPERFECT_ANBIETER=demo
JUSPERFECT_AWS_REGION=eu-central-1
JUSPERFECT_MODELL_ID=anthropic.claude-opus-5
JUSPERFECT_MODELL_ID_KLEIN=             # optional, für Triage; leer = wie MODELL_ID
# Modell je Aufgabe (optional, leer = wie MODELL_ID). Empfehlung: starkes Modell
# für Entwurf/Analyse, ausgewogenes für die Frage, schnelles/günstiges für die
# Eingangsprüfung.
# JUSPERFECT_MODELL_FRAGE=anthropic.claude-sonnet-5
# JUSPERFECT_MODELL_ANALYSE=anthropic.claude-opus-5
# JUSPERFECT_MODELL_TRIAGE=anthropic.claude-haiku-4-5
# JUSPERFECT_MODELL_ENTWURF=anthropic.claude-opus-5
JUSPERFECT_GUARDRAIL_ID=                # Bedrock Guardrail, wirkt auf Frage und Antwort
JUSPERFECT_GUARDRAIL_VERSION=DRAFT
JUSPERFECT_PROMPT_CACHE=1
JUSPERFECT_KANZLEIWISSEN_KB_ID=         # Bedrock Knowledge Base (Phase 2), optional

# jur|nodes: http (echte API), fixture (Testakten aus Ordner) oder
# webdav (Ordnerexport <Wurzel>/<Anwalt>/<Jahr>/<Aktenzeichen Bezeichnung>/)
JUSPERFECT_JURNODES_ADAPTER=fixture
JUSPERFECT_JURNODES_URL=
JUSPERFECT_JURNODES_TOKEN_VAR=JURNODES_API_TOKEN   # Name der Variablen mit dem Token
# Für den WebDAV-Ordnerexport der Kanzlei (eingebundenes Laufwerk):
# JUSPERFECT_JURNODES_ADAPTER=webdav
# JUSPERFECT_JURNODES_WEBDAV=J:\Akten
# Archivierte Akten werden in jurnodes von Hand gekennzeichnet; die Kennung
# steht dann im Ordnernamen. Daran liest jusperfect den Aktenstatus ab, an dem
# die Aufbewahrung des Aktengedächtnisses hängt. Vor dem Einsatz einmal mit
# „python -m jusperfect.ordnerpruefung" gegen den echten Bestand prüfen.
# Leer = keine Konvention, dann bleibt jeder Status unbekannt (nichts löschen).
JUSPERFECT_ARCHIV_KENNUNG=archiviert
JUSPERFECT_FIXTURE_PFAD=testdaten/akten

# Identität lokal: Kopfzeile X-Jusperfect-Nutzer, geprüft gegen diese Datei
JUSPERFECT_IDENTITAET=header
JUSPERFECT_NUTZER_DATEI=testdaten/nutzer.json

# Sitzungsspeicher lokal im Arbeitsspeicher; Lebensdauer in Sekunden
JUSPERFECT_SPEICHER=lokal
JUSPERFECT_SITZUNG_TTL_SEKUNDEN=604800   # sieben Tage fortsetzbar

# Dauerhaftes Aktengedächtnis: wegen Berufsgeheimnis und DSFA bewusst aus.
# Für eine lokale Demo: "lokal" und ein ausschließlich hierfür bestimmter Pfad.
# Im Echtbetrieb: "aws"; Bucket und KMS-Schlüssel kommen aus der SAM-Vorlage.
JUSPERFECT_GEDAECHTNIS=aus
JUSPERFECT_GEDAECHTNIS_PFAD=.jusperfect-gedaechtnis
JUSPERFECT_GEDAECHTNIS_BUCKET=
JUSPERFECT_GEDAECHTNIS_MAX_FRAGEN=100
# Keine Inaktivitätsfrist: Die Aufbewahrung folgt dem Aktenstatus in jurnodes.
# Erst der kontrollierte Abschlussworkflow exportiert und löscht den Arbeitsbereich.
# Leer = kleines Modell, danach Hauptmodell.
JUSPERFECT_MODELL_GEDAECHTNIS=

# OCR: keine | textract
JUSPERFECT_OCR=keine

# Haufe-Recherche: Direktlink zum Haufe-Copilot. jusperfect öffnet ihn im
# Browser (bestehende Login-Sitzung), fasst keine Zugangsdaten an. Leer = aus.
JUSPERFECT_HAUFE_URL=https://law.copilot.haufe.ai/
# Optionaler Suchparameter, falls Haufes URL einen annimmt (z. B. q). Leer =
# nur öffnen und die Frage in die Zwischenablage legen (nichts wird geraten).
JUSPERFECT_HAUFE_SUCHE_PARAM=

# Posteingang: ein beobachteter Ordner (eingebundenes OneDrive/Nextcloud/WebDAV).
# Leer = aus. Nur im lokalen Betrieb sinnvoll. jusperfect bereitet eingehende
# Dokumente vor; geprüft und eingeordnet werden sie von einem Menschen.
# JUSPERFECT_POSTEINGANG_ORDNER=/pfad/zum/posteingang

# Eigene Aufträge: ein Ordner mit .txt/.md-Dateien der Kanzlei. Dateiname =
# Beschriftung, Unterordner = Rechtsgebiet, Trennlinie („--- Rechtslage ---")
# teilt Anweisung und Material. Erscheinen als Entwurfsvorlagen. Leer = aus.
# JUSPERFECT_AUFTRAG_ORDNER=/pfad/zu/auftraegen

# Referenzen: ein Ordner mit veröffentlichtem Material (Urteile, Gesetze,
# Tarifverträge) als .txt/.md/.pdf. Der Bearbeiter zieht einzelne in den
# Kontext einer Sitzung; sie werden mitzitiert (Kennung R…). Leer = aus.
# JUSPERFECT_REFERENZ_ORDNER=/pfad/zu/referenzen

# Rückfragen erhalten die letzten geprüften Frage-Antwort-Runden als flüchtigen
# Sitzungskontext. Der Verlauf wird beim Schließen oder Ablauf gelöscht.
JUSPERFECT_DIALOG_MAX_RUNDEN=6

# Noch nicht setzen: Die vorhandene Browser-Erweiterung hat keine technische
# Anonymisierungs-Schnittstelle zu jusperfect. Eine Aktivierung wird fail-closed
# abgewiesen, damit die Oberfläche keinen tatsächlich fehlenden Schutz anzeigt.
# JUSPERFECT_PERFECT_SHIELD=0

# Aktengedächtnis: aus | lokal | aws. Die Aufbewahrung folgt dem Aktenstatus in
# jurnodes, nicht der Zeit. Nach einem *bestätigten* Abschluss der Akte läuft
# diese Übergangsfrist, erst danach ist der Abschluss ausführbar.
JUSPERFECT_GEDAECHTNIS_UEBERGANGSFRIST_TAGE=30

# Kostenwächter: monatliche Obergrenze in EUR
JUSPERFECT_MONATSBUDGET_EUR=125

JUSPERFECT_HOST=127.0.0.1
JUSPERFECT_PORT=8765
